# If behind a reverse proxy, set this to your domain
# i.e. https://wishlist.your-domain.org
ORIGIN=
# Hours until signup and password reset tokens expire
TOKEN_TIME=72
# The currency to use when a product search does not return a currency
DEFAULT_CURRENCY=USD
# Set the logging level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Maxinum image size that can be uploaded (in bytes)
MAX_IMAGE_SIZE=5000000
# IPs allowed to bypass SSRF protection. Only add IPs that are trusted
ALLOWED_IPS=

# Registration protection (limits include invitations and first-time OIDC/header users)
REGISTRATION_RATE_LIMIT_ENABLED=true
REGISTRATION_ACCOUNT_LIMIT=3
REGISTRATION_ACCOUNT_WINDOW_SECONDS=3600
REGISTRATION_ATTEMPT_LIMIT=10
REGISTRATION_ATTEMPT_WINDOW_SECONDS=600
# Group changing IPv6 addresses by network prefix (128 = individual addresses)
REGISTRATION_IPV6_PREFIX=64
# Optional stable HMAC secret; otherwise generated once and stored in the database
REGISTRATION_IP_HASH_SECRET=
# Optional Cloudflare Turnstile. When enabled, all three values and ORIGIN are required.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# For a trusted reverse proxy ONLY; configure for your actual proxy chain.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
